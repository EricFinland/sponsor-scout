# Without storage settings, the app runs in browser-local demo mode.

# Existing Thirst Project partners, comma-separated. Kept private, never committed.
PARTNER_COMPANIES=

# Hunter.io key for work email lookup (free tier: 50 credits a month).
HUNTER_API_KEY=

# SEC fair-access identification, e.g. Sponsor Scout admin@your-organization.org.
# Server-only contact header, not an API key. No AI service is used.
SEC_USER_AGENT=

# Private Google Sheets storage through the bound Apps Script web app.
# Setup steps: docs/SHEET_SYNC.md
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# Workspace access: private (default), public-read, or public-edit.
# public-read opens the website without sign-in and rejects shared-data writes.
# public-edit allows every visitor to edit shared data.
WORKSPACE_ACCESS=private

# Required only in private mode. Use a random value of at least 24 characters.
# Store server-side only. Never use a NEXT_PUBLIC_ prefix for any credential.
TEAM_ACCESS_KEY=
