# Without storage settings, the app runs in browser-local demo mode.

# Existing Thirst Project partners, comma-separated. Kept private, never committed.
PARTNER_COMPANIES=

# Hunter.io key for work email lookup (free tier: 50 credits a month).
HUNTER_API_KEY=

# Private Google Sheets storage through the bound Apps Script web app.
# Setup steps: docs/SHEET_SYNC.md
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# Required when SHEET_WEBHOOK_URL is set. Use a random value of at least 24 characters.
# Store server-side only. Never use a NEXT_PUBLIC_ prefix for any credential.
TEAM_ACCESS_KEY=
